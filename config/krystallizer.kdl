// Krystallizer configuration. One file; each subsystem gets a top-level
// node. Credentials are NEVER stored here — every secret is referenced
// by the environment variable name that holds it.
//
// Node names are kebab-case (knus maps Rust field names via kebab-case).
//
// === embedding ===
// The built-in local embedding model for mem-core retrieval (ADR-0003):
// it runs IN this process — no endpoint, no key, no transport hop — so
// the node names the artifact's local DIRECTORY, not a provider. The
// three files are found by name inside it (config.json / model.safetensors
// / tokenizer.json); the artifact itself is not in this repo (this
// machine keeps bge-small-zh-v1.5, 512-dim, CLS pooling, under
// ~/.local/share/krystallizer/models/). A deployment parameter, so the
// environment variable KRYSTALLIZER_MODEL_DIR overrides this value.
embedding {
    model-dir "/home/master/.local/share/krystallizer/models/bge-small-zh-v1.5"
    dimensions 512
    metric "cosine"
}
