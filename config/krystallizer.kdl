// Krystallizer configuration. One file; each subsystem gets a top-level
// node. Credentials are NEVER stored here — every secret is referenced
// by the environment variable name that holds it.
//
// The file is named `krystallizer.kdl`. The service reads the one BESIDE
// ITS BINARY unless `--config <path>` names another, so a deployment ships
// the binary and this file together. In this repo it lives under config/.
//
// Path values may carry `$HOME` (the one placeholder there is; anything
// else, `$FOO`, stays literal text). A machine's home directory is a
// deployment fact, not a property of the software.
//
// Node names are kebab-case (knus maps Rust field names via kebab-case).
//
// === storage ===
// The database's home on disk (ADR-0002: k10r owns its Fjall directory).
// One directory, one lock file, every table group inside it. It is stated
// here and not on the command line because it is the service's own state:
// a flag is a supervisor remembering something the file could say.
storage {
    data-dir "$HOME/.local/share/krystallizer/data"
}

// === embedding ===
// WHICH embedding engine retrieval runs on (ADR-0003). Both modes must produce
// one unit-length vector per text at `dimensions`, so the store never learns
// where the vector came from.
//
//   mode "local"  — the built-in model runs IN this process: no endpoint, no
//                   key, no transport hop. It names the artifact's local
//                   DIRECTORY; the three files are found by name inside it
//                   (config.json / model.safetensors / tokenizer.json). The
//                   artifact itself is not in this repo (this machine keeps
//                   bge-small-zh-v1.5, 512-dim, CLS pooling, under
//                   $HOME/.local/share/krystallizer/models/). A deployment
//                   parameter, so KRYSTALLIZER_MODEL_DIR overrides it.
//
//   mode "remote" — an OpenAI-shaped embeddings service (POST
//                   {base-url}/embeddings) computes the vectors, e.g. on a GPU
//                   box. Required: base-url (WITHOUT the /embeddings suffix),
//                   model. Optional: api-key-env (the NAME of the variable
//                   holding the bearer token — never the key), timeout-ms.
//                   The width that comes back is checked against `dimensions`,
//                   and the vector is normalized here, not trusted.
//
// Either mode is proven at BOOT: a missing artifact or an unreachable/wrong-width
// service is a start failure, because a k10r that cannot embed cannot serve
// retrieval. A field belonging to the other mode is a typo and fails the start.
embedding {
    mode "local"
    model-dir "$HOME/.local/share/krystallizer/models/bge-small-zh-v1.5"
    dimensions 512
    metric "cosine"
}

// === compression ===
// The Phase 2.6 policy engine's numbers (ADR-0008 §4). All four are
// parameters, never constants: the tuning pass is deferred until feedback
// labels exist, because fitting a policy to unlabelled traces fits noise.
// context-bytes is the CONSUMER's model window expressed in bytes — k10r
// holds no tokenizer for another model, so bytes are the honest unit, and
// the mid-band percentage below is what turns the window into a trigger.
compression {
    context-bytes 131072
    budget-percent 50
    cache-ttl-ms 300000
    floor-bytes 2048
}

// === logs ===
// The structured log's ceiling (ADR-0011). One table (ns 41) holds the
// diagnostics that are neither knowledge nor conversation — compression
// verdicts with their signal values, index rebuilds, engine errors — so it
// is written by k10r itself and has no door. It is DISPOSABLE: every append
// past max-rows deletes the oldest rows, and the delete is never logged
// (trimming would emit rows that trigger trimming).
logs {
    max-rows 10000
}
